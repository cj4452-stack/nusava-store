  <script define:vars={{ regionesData: REGIONES_CHILE }}>
    // Cambiar imagen de galería
    window.changeImage = function(src, btn) {
      document.getElementById('mainImage').src = src;
      document.querySelectorAll('.thumb-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    };

    // Selección de Packs
    const packCards = document.querySelectorAll('.pack-card');
    const summaryTitle = document.getElementById('summaryPackTitle');
    const summaryPrice = document.getElementById('summaryPackPrice');
    const stickyTitle = document.getElementById('stickyPackTitle');
    const stickyPrice = document.getElementById('stickyPackPrice');
    const formPackId = document.getElementById('formPackId');

    packCards.forEach(card => {
      card.addEventListener('click', () => {
        packCards.forEach(c => c.classList.remove('selected'));
        card.classList.add('selected');
        
        const radio = card.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;

        const packId = card.getAttribute('data-pack-id');
        const price = parseInt(card.getAttribute('data-price'), 10);
        const title = card.getAttribute('data-title');
        const formattedPrice = '$' + price.toLocaleString('es-CL') + ' CLP';

        formPackId.value = packId;
        summaryTitle.textContent = title;
        summaryPrice.textContent = formattedPrice;
        stickyTitle.textContent = title;
        stickyPrice.textContent = formattedPrice;
      });
    });

    // Cascada de Regiones y Comunas de Chile
    const regionSelect = document.getElementById('regionSelect');
    const comunaSelect = document.getElementById('comunaSelect');

    regionSelect.addEventListener('change', () => {
      const selectedRegion = regionSelect.value;
      comunaSelect.innerHTML = '<option value="">Selecciona tu comuna...</option>';

      if (!selectedRegion) {
        comunaSelect.disabled = true;
        return;
      }

      const match = regionesData.find(r => r.region === selectedRegion);
      if (match && match.comunas) {
        match.comunas.forEach(comuna => {
          const opt = document.createElement('option');
          opt.value = comuna;
          opt.textContent = comuna;
          comunaSelect.appendChild(opt);
        });
        comunaSelect.disabled = false;
      }
    });

    // Envío del Formulario COD
    const orderForm = document.getElementById('orderForm');
    const submitBtn = document.getElementById('submitBtn');

    orderForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'PROCESANDO TU PEDIDO...';

      const formData = {
        customerName: document.getElementById('customerName').value,
        customerPhone: document.getElementById('customerPhone').value,
        customerEmail: document.getElementById('customerEmail').value,
        region: regionSelect.value,
        comuna: comunaSelect.value,
        address: document.getElementById('address').value,
        packId: formPackId.value
      };

      try {
        const res = await fetch('/api/orders/cod', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData)
        });

        const data = await res.json();

        if (data.ok && data.whatsappUrl) {
          window.location.href = data.whatsappUrl;
        } else {
          alert(data.error || 'Ocurrió un error. Por favor intenta de nuevo.');
          submitBtn.disabled = false;
          submitBtn.textContent = 'CONFIRMAR PEDIDO Y PAGAR AL RECIBIR ➜';
        }
      } catch (err) {
        alert('Error de conexión. Intenta nuevamente.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'CONFIRMAR PEDIDO Y PAGAR AL RECIBIR ➜';
      }
    });
  </script>

</body>
</html>
